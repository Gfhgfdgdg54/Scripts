-- ---------- camera ----------
local function restoreCamera()
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
    end
    if cam then cam.FieldOfView = 70 end
    gLat, gFwd, slipS, gSpeed, gLastVel = 0, 0, 0, 0, nil
    fovS = 70
    camInit = false
end

-- Measures how hard the car is accelerating (G-force) and how sideways it is sliding (drift angle)
local function updateGForce(seat, dt)
    if dt <= 0 then return end
    local vel = seat.AssemblyLinearVelocity

    if gLastVel then
        local acc = (vel - gLastVel) / dt
        local localAcc = seat.CFrame:VectorToObjectSpace(acc)
        local grav = workspace.Gravity
        local latTarget = math.clamp(localAcc.X / grav, -3, 3)
        local fwdTarget = math.clamp(-localAcc.Z / grav, -3, 3)
        local a = 1 - math.exp(-6 * dt)
        gLat = gLat + (latTarget - gLat) * a
        gFwd = gFwd + (fwdTarget - gFwd) * a
    end
    gLastVel = vel

    -- drift (slip) angle: angle between where the car points and where it is actually moving
    local lv = seat.CFrame:VectorToObjectSpace(vel)
    gSpeed = vel.Magnitude
    local slipTarget = 0
    local slipRate = settings.returnSpeed * 0.25 -- when nearly stopped the swing fades out slowly (no snapping back)
    if gSpeed > 8 then
        local ang = math.atan2(lv.X, -lv.Z) -- -pi..pi
        if math.abs(ang) > 2.6 then
            -- driving straight backwards: no drift swing
            slipTarget = 0
            slipRate = settings.returnSpeed
        else
            -- keep the swing through big drift angles and spins instead of dropping to 0
            slipTarget = math.clamp(ang, -1.5, 1.5)
            -- swings out quickly, returns slowly
            slipRate = (math.abs(slipTarget) >= math.abs(slipS)) and settings.swingSpeed or settings.returnSpeed
        end
    end
    slipS = slipS + (slipTarget - slipS) * (1 - math.exp(-slipRate * dt))

    -- field of view goes from Min FOV (slow) to Max FOV (fast, accelerating, drifting)
    local slipNorm = math.clamp(math.abs(slipS) / 0.8, 0, 1)
    local t = math.clamp(math.clamp(gSpeed / 150, 0, 1) * 0.7 + math.clamp(gFwd, 0, 1) * 0.3 + slipNorm * 0.3, 0, 1)
    if settings.gforce <= 0 then t = 0 end
    local fovTarget = settings.fovMin + (settings.fovMax - settings.fovMin) * t
    fovS = fovS + (fovTarget - fovS) * (1 - math.exp(-4 * dt))

end

local function initCamera(seat, cam)
    local rel = seat.CFrame:PointToObjectSpace(cam.CFrame.Position) - Vector3.new(0, CAM_HEIGHT, 0)
    local dist = rel.Magnitude
    if dist < 1 then
        camYaw, camPitch, camDist = 0, math.rad(15), 20
    else
        camDist = math.clamp(dist, MIN_ZOOM, MAX_ZOOM)
        camPitch = math.asin(math.clamp(rel.Y / dist, -1, 1))
        camYaw = math.atan2(rel.X, rel.Z)
    end
    camInit = true
end

local function updateCamera(seat, cam, lookDx, lookDy)
    if not camInit then
        initCamera(seat, cam)
    end

    camYaw = camYaw - math.rad(lookDx * CAMERA_SENS)
    camPitch = math.clamp(camPitch + math.rad(lookDy * CAMERA_SENS), math.rad(-10), math.rad(80))

    local s = settings.gforce

    -- drift: the camera swings toward the direction the car is really travelling, up to "Max swing angle"
    local swing = 0
    if s > 0 then
        swing = math.clamp(slipS / 0.8, -1, 1) * math.rad(settings.swingMax)
    end
    local yawEff = camYaw - swing

    -- G-force: camera body-lags opposite to acceleration (leans out in corners, back on throttle)
    local sway = Vector3.new(-gLat * 1.2 * s, 0, gFwd * 1.0 * s)

    -- shake while drifting hard
    local intensity = math.clamp((math.abs(slipS) - 0.2) * 2, 0, 1) * s
    local n = tick() * 25
    local shake = Vector3.new(math.noise(n, 0.5), math.noise(n, 7.5), 0) * 0.25 * intensity

    local localPos = Vector3.new(
        math.cos(camPitch) * math.sin(yawEff),
        math.sin(camPitch),
        math.cos(camPitch) * math.cos(yawEff)
    ) * camDist + Vector3.new(0, CAM_HEIGHT, 0) + sway + shake

    local worldPos = seat.CFrame:PointToWorldSpace(localPos)
    local focus = seat.CFrame:PointToWorldSpace(Vector3.new(0, CAM_HEIGHT, 0))

    cam.CameraType = Enum.CameraType.Scriptable
    -- roll the camera into the corner with lateral G
    cam.CFrame = CFrame.lookAt(worldPos, focus) * CFrame.Angles(0, 0, math.rad(-gLat * 3 * s))
    cam.FieldOfView = fovS
end

-- ---------- mobile controls ----------
local function touchAngle(pos)
    local hit = mobileUI and mobileUI.hit
    if not hit then return 0 end
    local c = hit.AbsolutePosition + hit.AbsoluteSize / 2
    return math.atan2(pos.X - c.X, -(pos.Y - c.Y)) -- 0 = straight up, clockwise positive
end

-- Lets a finger drag a frame around. The frame must use AnchorPoint 0.5,0.5; its position is
-- kept as a fraction of the screen so it works with any screen size and any UIScale.
-- threshold: pixels the finger must travel before dragging starts (so buttons can still be tapped).
-- Returns a table whose "moved" field is true if the last touch turned into a drag.
local function makeMoveable(frame, canMove, onDone, threshold)
    local state = { moved = false }
    local dragging, startIn, startCenter
    threshold = threshold or 0
    track(frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch and not dragging and canMove() then
            dragging = input
            state.moved = false
            startIn = Vector2.new(input.Position.X, input.Position.Y)
            startCenter = frame.AbsolutePosition + frame.AbsoluteSize / 2
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragging then
            local d = Vector2.new(input.Position.X, input.Position.Y) - startIn
            if not state.moved then
                if d.Magnitude < threshold then return end
                state.moved = true
            end
            local c = startCenter + d
            local sz = frame.Parent.AbsoluteSize
            if sz.X > 0 and sz.Y > 0 then
                frame.Position = UDim2.new(math.clamp(c.X / sz.X, 0.04, 0.96), 0, math.clamp(c.Y / sz.Y, 0.04, 0.96), 0)
            end
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if dragging and input == dragging then
            dragging = nil
            if state.moved and onDone then onDone(frame.Position.X.Scale, frame.Position.Y.Scale) end
        end
    end))
    return state
end

