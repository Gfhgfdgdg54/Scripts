    local seat = hum and hum.SeatPart
    if seat and seat:IsA("BasePart") then
        return seat
    end
    return nil
end

-- ---------- direct wheel steering (same method the game uses: FR/FL Axel.Attachment0.Axis) ----------
local currentCar = nil
local baseAxes = {}
local directOn = false
local steerOut = 0
local stepConn

local function carFromSeat(seat)
    local cars = workspace:FindFirstChild("Cars")
    local m = seat
    while m and m.Parent do
        if cars and m.Parent == cars then return m end
        m = m.Parent
    end
    return nil
end

-- value is the wheel steering angle value (negative = left, positive = right). Returns true if wheels were found.
local function applyAxis(value)
    if not currentCar or not currentCar.Parent then return false end
    local applied = false
    for _, name in ipairs({ "FR", "FL" }) do
        local wheel = currentCar:FindFirstChild(name)
        local axel = wheel and wheel:FindFirstChild("Axel")
        local att = axel and axel:FindFirstChild("Attachment0")
        if att then
            local base = baseAxes[att]
            if not base then
                local a = att.Axis
                base = Vector3.new(a.X, a.Y, 0)
                baseAxes[att] = base
            end
            att.Axis = Vector3.new(base.X, base.Y, value)
            applied = true
        end
    end
    return applied
end

