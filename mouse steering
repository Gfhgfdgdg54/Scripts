        b.Text = label
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        track(b.Activated:Connect(callback))
    end
    button("PC", 0.28, not touchOnly, startPC)
    button("Mobile", 0.72, touchOnly, startMobile)
end

-- ---------- input handling ----------
track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rmbHeld = true
    end
    if gameProcessed then return end
    if platform ~= "pc" then return end

    if input.KeyCode == TOGGLE_KEY then
        enabled = not enabled
        if enabled then
            task.spawn(function()
                fixCam()
                if enabled then
                    start()
                    if mmr then
                        notify("Mouse steering ON. Cursor = wheel. I = settings.")
                    else
                        notify("ON (no mousemoverel: locked-mouse mode, watch the bar)")
                    end
                end
            end)
        else
            stop()
            task.spawn(fixCam)
            notify("Mouse steering OFF")
        end
    elseif input.KeyCode == MENU_KEY then
        if menuGui then
            menuGui.set(not mainOpen)
        end
    elseif input.KeyCode == STEER_KEY then
        if not enabled then
            notify("Press J first to turn the script on")
        else
            steerPaused = not steerPaused
            if steerPaused then
                directOn = false
                applyAxis(0) -- straighten the wheels once, then the game's own steering takes over
                targetSteer, currentSteer, filteredDx = 0, 0, 0
                releaseKeys()
                notify("Mouse steering OFF (X to turn back on)")
            else
                expectedX = nil
                notify("Mouse steering ON")
            end
        end
    elseif input.KeyCode == GMENU_KEY then
        if gMenuGui then
            gMenuGui.set(not gOpen)
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        rmbHeld = false
    end
    if wheelTouch and input == wheelTouch then
        wheelTouch = nil
    end
    if gasTouch and input == gasTouch then
        gasTouch = nil
        setW(false)
    end
    if brakeTouch and input == brakeTouch then
        brakeTouch = nil
        setS(false)
    end
end))

-- mobile: finger on the wheel turns it, any other finger drags the camera
track(UserInputService.InputChanged:Connect(function(input, gameProcessed)
    if platform ~= "mobile" or input.UserInputType ~= Enum.UserInputType.Touch then return end
    if wheelTouch and input == wheelTouch then
        local ang = touchAngle(input.Position)
        local d = (ang - wheelLastAng + math.pi) % (2 * math.pi) - math.pi
        wheelLastAng = ang
        wheelRot = math.clamp(wheelRot + d, -WHEEL_MAX, WHEEL_MAX)
    elseif not gameProcessed and not menuOpen and not pinchActive then
        mobLookDx = mobLookDx + input.Delta.X
        mobLookDy = mobLookDy + input.Delta.Y
    end
end))

-- mobile: pinch to zoom
track(UserInputService.TouchPinch:Connect(function(positions, scale, velocity, state, gameProcessed)
    if platform ~= "mobile" then return end
    if state == Enum.UserInputState.Begin then
        pinchActive = true
        pinchStart = camDist
    elseif state == Enum.UserInputState.Change then
        if pinchStart and not gameProcessed and not menuOpen then
            camDist = math.clamp(pinchStart / math.max(scale, 0.1), MIN_ZOOM, MAX_ZOOM)
        end
    else
        pinchActive = false
        pinchStart = nil
    end
end))

createMenu()
createGMenu()

-- ---------- cleanup hook for re-execution ----------
env.MouseSteerCleanup = function()
    enabled = false
    pcall(stop)
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    conns = {}
    if menuGui and menuGui.gui then
        pcall(function() menuGui.gui:Destroy() end)
    end
    if gMenuGui and gMenuGui.gui then
        pcall(function() gMenuGui.gui:Destroy() end)
    end
    destroyBar()
    destroyMobileUI()
    destroyPicker()
    releaseKeys()
end

showPicker()
