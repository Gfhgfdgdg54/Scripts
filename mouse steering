-- ---------- start / stop ----------
local function stop()
    if connection then
        connection:Disconnect()
        connection = nil
    end
    if wheelConn then
        wheelConn:Disconnect()
        wheelConn = nil
    end
    if stepConn then
        stepConn:Disconnect()
        stepConn = nil
    end
    directOn = false
    applyAxis(0)
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true
    releaseKeys()
    restoreCamera()
    destroyBar()
    targetSteer, currentSteer, filteredDx = 0, 0, 0
    expectedX = nil
end

local function start()
    targetSteer, currentSteer, filteredDx, pwmAcc = 0, 0, 0, 0
    camInit = false
    expectedX = nil
    wasLook = false
    steerPaused = false
    if platform ~= "mobile" then createBar() end

    wheelConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel and not menuOpen then
            camDist = math.clamp(camDist - input.Position.Z * ZOOM_STEP, MIN_ZOOM, MAX_ZOOM)
        end
    end)

    -- also set the wheels right before every physics step so the game can't pull them back
    stepConn = RunService.Stepped:Connect(function()
        if directOn then
            applyAxis(steerOut * settings.maxAngle)
        end
    end)

    connection = RunService.RenderStepped:Connect(function(dt)
        if fixing then return end

        local seat = getSeat()
        local cam = workspace.CurrentCamera

        local car = seat and carFromSeat(seat) or nil
        if car ~= currentCar then
            if currentCar then applyAxis(0) end
            currentCar = car
            baseAxes = {}
        end

        if not seat then
            directOn = false
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            releaseKeys()
            restoreCamera()
            targetSteer, currentSteer, filteredDx = 0, 0, 0
            expectedX = nil
            if barMarker then barMarker.Position = UDim2.new(0.5, 0, 0.5, 0) end
            if mobileUI then mobileUI.setVisible(moveMode and not menuOpen) end
            wheelRot, wheelTouch, gasTouch, brakeTouch = 0, nil, nil, nil
            return
        end

        updateGForce(seat, dt)

        if mobileUI then
            mobileUI.setVisible(not menuOpen)
            mobileUI.vis.Rotation = math.deg(wheelRot)
            if menuOpen or moveMode then
                gasTouch, brakeTouch = nil, nil
                setW(false)
                setS(false)
            end
            mobileUI.pedals(wDown, sDown)
            local thr = (wDown and 1 or 0) - (sDown and 1 or 0)
            if thr ~= lastThr then
                lastThr = thr
                pcall(function()
                    if seat:IsA("VehicleSeat") then seat.ThrottleFloat = thr end
                end)
            end
        end

        local lookMode = (not menuOpen) and (rmbHeld or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
        local sens = math.max(settings.sensitivity, 0.05)

        -- ===== input =====
        if platform == "mobile" then
            -- touch: the wheel steers and STAYS where you leave it; one finger drags the camera
            local lx, ly = mobLookDx, mobLookDy
            mobLookDx, mobLookDy = 0, 0
            if cam then updateCamera(seat, cam, lx, ly) end
            targetSteer = math.clamp(wheelRot / WHEEL_MAX * sens, -MAX_STEER, MAX_STEER)
            expectedX = nil
        elseif menuOpen then
            -- menu open: free cursor, car goes straight
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            if cam then updateCamera(seat, cam, 0, 0) end
            targetSteer = 0
            expectedX = nil
        elseif steerPaused then
            -- X pressed: mouse steering is off. Normal free cursor, normal A/D driving.
            -- Right click still lets you look around.
            if lookMode then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                local delta = UserInputService:GetMouseDelta()
                if cam then updateCamera(seat, cam, delta.X, delta.Y) end
            else
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                UserInputService.MouseIconEnabled = true
                if cam then updateCamera(seat, cam, 0, 0) end
            end
            targetSteer = 0
            expectedX = nil
        elseif mmr then
            -- REAL CURSOR MODE
            if lookMode then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                local delta = UserInputService:GetMouseDelta()
                if cam then updateCamera(seat, cam, delta.X, delta.Y) end
                expectedX = nil
                wasLook = true
            else
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                UserInputService.MouseIconEnabled = true
                if cam then updateCamera(seat, cam, 0, 0) end

                local view = cam and cam.ViewportSize or Vector2.new(1920, 1080)
                local cx = view.X / 2
                local range = view.X * BASE_RANGE / sens
                local m = UserInputService:GetMouseLocation()

                if expectedX and not wasLook and math.abs(m.X - expectedX) > 1.5 then
                    targetSteer = (m.X - cx) / range
                end
                wasLook = false

                targetSteer = math.clamp(targetSteer, -MAX_STEER, MAX_STEER)

                -- keep the cursor inside the steering range (horizontal only)
                local desiredX = cx + targetSteer * range
                local dxMove = (desiredX - m.X) * CURSOR_PULL
                if math.abs(dxMove) >= 0.5 then
                    pcall(mmr, dxMove, 0)
                end
                expectedX = m.X + dxMove
            end
        else
            -- FALLBACK: locked mouse, delta steering
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            local delta = UserInputService:GetMouseDelta()
            if cam then
                if lookMode then updateCamera(seat, cam, delta.X, delta.Y)
                else updateCamera(seat, cam, 0, 0) end
            end
            local rawDx = lookMode and 0 or delta.X
            filteredDx = filteredDx + (rawDx - filteredDx) * (1 - math.exp(-DELTA_FILTER * dt))
            if not lookMode then
                targetSteer = targetSteer + filteredDx * FALLBACK_SENS * sens
            end
            targetSteer = math.clamp(targetSteer, -MAX_STEER, MAX_STEER)
        end

        -- ===== smoothing (0 = instant) =====
        if settings.smooth <= 0.001 then
            currentSteer = targetSteer
        else
            local rate = 40 / settings.smooth
            currentSteer = currentSteer + (targetSteer - currentSteer) * (1 - math.exp(-rate * dt))
        end

        local out = currentSteer
        if steerPaused then
            out = 0
            currentSteer = 0
        end
        if math.abs(out) < DEADZONE then out = 0 end

        if barMarker then
            barMarker.Position = UDim2.new(0.5, out * 150, 0.5, 0)
        end

        pcall(function()
            if seat:IsA("VehicleSeat") then
                seat.SteerFloat = out
            end
        end)

        -- ===== analog -> A/D pulses (joystick-like) =====
        local dir = (out > 0 and 1) or (out < 0 and -1) or 0

        -- Direct wheel steering: sets the wheel angle itself, so no A/D keys and no auto-return/lag
        steerOut = out
        directOn = (not steerPaused) and applyAxis(out * settings.maxAngle)

        if directOn then
            setA(false)
            setD(false)
            pwmAcc = 0
            lastDir = 0
        elseif dir == 0 then
            setA(false)
            setD(false)
            pwmAcc = 0
            lastDir = 0
        else
            if dir ~= lastDir then
                pwmAcc = 1 -- press immediately when a turn starts (no delay)
                lastDir = dir
            end
            local mag = math.abs(out)
            if mag >= HOLD_THRESHOLD then
                pwmAcc = 1
                if dir > 0 then setA(false) setD(true) else setD(false) setA(true) end
            else
                pwmAcc = pwmAcc + mag
                local press = false
                if pwmAcc >= 1 then
                    pwmAcc = pwmAcc - 1
                    press = true
                end
                if dir > 0 then
                    setA(false)
                    setD(press)
                else
                    setD(false)
                    setA(press)
                end
            end
        end
    end)
end

