if isMobile then

    local function createMobileBtn(icon, labelTxt, defaultPos)
        local sz = mobileState.btnSize
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, sz, 0, sz)
        frame.Position = defaultPos
        frame.BackgroundColor3 = C.mobileBg
        frame.BackgroundTransparency = 0.15
        frame.ZIndex = 10
        frame.Active = true
        frame.Parent = sg
        uiCorner(frame, 12)
        uiStroke(frame, C.border, 2)

        -- Só visual — Active=false pra NÃO roubar o toque do Frame
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text = icon
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = math.floor(sz * 0.40)
        btn.TextColor3 = C.text
        btn.ZIndex = 11
        btn.AutoButtonColor = false
        btn.Active = false
        btn.Parent = frame
        uiCorner(btn, 12)

        if labelTxt then
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 11)
            lbl.Position = UDim2.new(0, 0, 0.67, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = labelTxt
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 8
            lbl.TextColor3 = C.mobileLabel
            lbl.ZIndex = 12
            lbl.Active = false
            lbl.Parent = frame
        end

        return frame, btn
    end

    local frenteFrame, frenteBtn = createMobileBtn("▲", "Frente", UDim2.new(0.82, 0, 0.70, 0))
    local reFrame,     reBtn     = createMobileBtn("▼", "Ré",     UDim2.new(0.82, 0, 0.87, 0))
    local esqFrame,    esqBtn    = createMobileBtn("◀", "Esq",    UDim2.new(0.71, 0, 0.78, 0))
    local dirFrame,    dirBtn    = createMobileBtn("▶", "Dir",    UDim2.new(0.93, 0, 0.78, 0))

    mobileState.btnRefs.frente = frenteFrame
    mobileState.btnRefs.re     = reFrame
    mobileState.btnRefs.esq    = esqFrame
    mobileState.btnRefs.dir    = dirFrame

    -- ─────────────────────────────────────────────────────
    -- setupMobileBtn:
    --   • InputBegan no Frame (filhos com Active=false)
    --   • InputChanged GLOBAL → arrasta mesmo com dedo fora do botão
    --   • InputEnded GLOBAL → só para quando SOLTAR o dedo
    -- ─────────────────────────────────────────────────────
    local function setupMobileBtn(frame, onPress, onRelease)
        local activeInput = nil
        local dragging    = false
        local isMouse     = false
        local dragStart   = nil
        local startPos    = nil
        local pressed     = false  -- modo locked: botão pressionado

        frame.InputBegan:Connect(function(i)
            local isTouch = i.UserInputType == Enum.UserInputType.Touch
            local isBtn1  = i.UserInputType == Enum.UserInputType.MouseButton1
            if not isTouch and not isBtn1 then return end
            if dragging or pressed then return end

            isMouse = isBtn1
            activeInput = isTouch and i or nil

            if mobileState.locked then
                pressed = true
                if onPress then onPress() end
                TweenService:Create(frame, TweenInfo.new(0.08), { BackgroundTransparency = 0 }):Play()
            else
                dragging  = true
                dragStart = Vector2.new(i.Position.X, i.Position.Y)
                startPos  = frame.Position
            end
        end)

        -- Arrasta GLOBALMENTE (dedo/mouse pode sair de cima do botão)
        local c1 = UserInputService.InputChanged:Connect(function(i)
            if not dragging then return end
            if isMouse then
                if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            else
                if i ~= activeInput then return end
            end
            local d = Vector2.new(i.Position.X, i.Position.Y) - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end)
        table.insert(connections, c1)

        -- Só termina quando SOLTAR
        local c2 = UserInputService.InputEnded:Connect(function(i)
            local ended = false
            if isMouse then
                ended = (i.UserInputType == Enum.UserInputType.MouseButton1)
            else
                ended = (i == activeInput)
            end
            if not ended then return end

            activeInput = nil
            if pressed then
                pressed = false
                if onRelease then onRelease() end
                TweenService:Create(frame, TweenInfo.new(0.08), { BackgroundTransparency = 0.15 }):Play()
            elseif dragging then
                dragging = false
            end
        end)
        table.insert(connections, c2)
    end

    setupMobileBtn(frenteFrame,
        function()
            if not motorState.enabled or not isPlayerInCar(currentCar) then return end
            motorState.currentDir = "Frente"; aplicarMotor("Frente")
        end,
        function() motorState.currentDir = "Parar"; aplicarMotor("Parar") end
    )

    setupMobileBtn(reFrame,
        function()
            if not motorState.enabled or not isPlayerInCar(currentCar) then return end
            motorState.currentDir = "Re"; aplicarMotor("Re")
        end,
        function() motorState.currentDir = "Parar"; aplicarMotor("Parar") end
    )

    setupMobileBtn(esqFrame,
        function() if steerState.enabled then steerState.isA = true end end,
        function() steerState.isA = false end
    )

    setupMobileBtn(dirFrame,
        function() if steerState.enabled then steerState.isD = true end end,
        function() steerState.isD = false end
    )
end

