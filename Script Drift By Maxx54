    local lockBtn = Instance.new("TextButton"); lockBtn.Size = UDim2.new(0.4, 0, 0.83, 0); lockBtn.Position = UDim2.new(0.59, 0, 0.085, 0); lockBtn.BackgroundColor3 = C.off; lockBtn.Text = "OFF"; lockBtn.Font = Enum.Font.GothamBold; lockBtn.TextSize = 9; lockBtn.TextColor3 = C.text; lockBtn.Parent = lockRow
