        uiCorner(box, 4); uiStroke(box, C.border, 1)
        return box
    end

    local function makeSubToggle(lOrder, lblTxt, defaultState, callback)
        local row = Instance.new("Frame"); row.Size = UDim2.new(1, 0, 0, 18); row.BackgroundTransparency = 1; row.LayoutOrder = lOrder; row.Parent = sec
        local lbl = Instance.new("TextLabel"); lbl.BackgroundTransparency = 1; lbl.Size = UDim2.new(0.58, 0, 1, 0); lbl.Text = lblTxt; lbl.Font = Enum.Font.Gotham; lbl.TextSize = 10; lbl.TextColor3 = C.dim; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = row
        local btn = Instance.new("TextButton"); btn.Size = UDim2.new(0.4, 0, 0.83, 0); btn.Position = UDim2.new(0.59, 0, 0.085, 0); btn.BackgroundColor3 = defaultState and C.on or C.off; btn.Text = defaultState and "ON" or "OFF"; btn.Font = Enum.Font.GothamBold; btn.TextSize = 9; btn.TextColor3 = C.text; btn.Parent = row
        uiCorner(btn, 4)
        local cur = defaultState
        btn.MouseButton1Click:Connect(function()
            cur = not cur; btn.Text = cur and "ON" or "OFF"
            TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = cur and C.on or C.off }):Play()
            if callback then callback(cur) end
