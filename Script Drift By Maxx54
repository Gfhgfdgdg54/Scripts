        TweenService:Create(lockBtn, TweenInfo.new(0.2), { BackgroundColor3 = mobileState.locked and C.on or C.off }):Play()
        local borderColor = mobileState.locked and C.mobileLocked or C.border
        for _, frame in pairs(mobileState.btnRefs) do
            if frame and frame:IsA("Frame") then
                local s = frame:FindFirstChildWhichIsA("UIStroke")
