-- ─────────────────────────────────────────────────────────────
-- makeDraggable — Mouse + Touch | continua arrastando mesmo fora do handle
-- Mouse: MouseButton1 e MouseMovement são InputObjects DIFERENTES → trata separado
-- Touch: mesmo InputObject do Began até o Ended
-- ─────────────────────────────────────────────────────────────
local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging    = false
    local isMouse     = false
    local dragStart   = nil
    local startPos    = nil
    local activeInput = nil  -- só usado no Touch

    local function beginDrag(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging    = true
            isMouse     = true
            activeInput = nil
            dragStart   = Vector2.new(i.Position.X, i.Position.Y)
            startPos    = frame.Position
        elseif i.UserInputType == Enum.UserInputType.Touch then
            dragging    = true
            isMouse     = false
            activeInput = i
            dragStart   = Vector2.new(i.Position.X, i.Position.Y)
            startPos    = frame.Position
        end
    end

    -- Conecta InputBegan no handle e em todos os filhos (evita input roubado)
    local function connectBegan(obj)
        obj.InputBegan:Connect(beginDrag)
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("GuiObject") then
                connectBegan(child)
            end
        end
    end
    connectBegan(handle)

    -- InputChanged GLOBAL
    local c1 = UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if isMouse then
            -- Mouse: aceita qualquer MouseMovement
            if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        else
            -- Touch: precisa ser o mesmo InputObject
            if i ~= activeInput then return end
        end
        local d = Vector2.new(i.Position.X, i.Position.Y) - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end)
    table.insert(connections, c1)

    -- InputEnded GLOBAL: só para quando soltar
    local c2 = UserInputService.InputEnded:Connect(function(i)
        if not dragging then return end
        if isMouse then
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        else
            if i == activeInput then
                dragging    = false
                activeInput = nil
            end
        end
    end)
    table.insert(connections, c2)
end

