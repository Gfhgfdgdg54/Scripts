    local mApply = Instance.new("TextButton"); mApply.Size = UDim2.new(1, 0, 0, 16); mApply.BackgroundColor3 = C.apply; mApply.Text = "Aplicar"; mApply.Font = Enum.Font.GothamBold; mApply.TextSize = 10; mApply.TextColor3 = C.text; mApply.LayoutOrder = 10; mApply.Parent = mobileSec; uiCorner(mApply, 4)
    local function flashM(color)
        TweenService:Create(mApply, TweenInfo.new(0.1), { BackgroundColor3 = color }):Play()
        task.delay(0.4, function() TweenService:Create(mApply, TweenInfo.new(0.2), { BackgroundColor3 = C.apply }):Play() end)
    end

    lockBtn.MouseButton1Click:Connect(function()
